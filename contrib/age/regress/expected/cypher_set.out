-- every SubLink-producing expression is allowed on the right-hand side, not
-- only list comprehensions
SELECT * FROM cypher('cypher_set_sorted', $$
    MATCH (n:P) SET n.all_pos = all(x IN [1, 2] WHERE x > 0) RETURN n.all_pos
$$) AS (all_pos agtype);
 all_pos 
---------
 true
 true
