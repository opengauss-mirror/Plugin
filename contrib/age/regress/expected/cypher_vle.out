-- Exercise VLE local-context cache eviction, rebuild, and LRU promotion.
PREPARE vle_cache_probe_1 AS
SELECT count(*) AS cached_paths
FROM cypher('cypher_vle', $$
    MATCH (:begin)-[:edge*1..1]->()
    RETURN 1
$$) AS (result agtype);
PREPARE vle_cache_probe_2 AS
SELECT count(*) AS cached_paths
FROM cypher('cypher_vle', $$
    MATCH (:begin)-[:edge*1..1]->()
    RETURN 1
$$) AS (result agtype);
