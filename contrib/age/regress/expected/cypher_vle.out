    MATCH (:begin)-[:edge*1..1]->()
    RETURN 1
$$) AS (result agtype);
PREPARE vle_cache_probe_5 AS
SELECT count(*) AS cached_paths
FROM cypher('cypher_vle', $$
    MATCH (:begin)-[:edge*1..1]->()
    RETURN 1
$$) AS (result agtype);
PREPARE vle_cache_probe_6 AS
SELECT count(*) AS cached_paths
FROM cypher('cypher_vle', $$
    MATCH (:begin)-[:edge*1..1]->()
