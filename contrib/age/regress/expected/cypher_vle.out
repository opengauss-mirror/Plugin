    OPTIONAL MATCH (c)-[:HAS_PLACE*]->(place)
    OPTIONAL MATCH (place)-[:NEARBY*]->(other)
    RETURN p.name, place.name, other
    ORDER BY p.name
$$) AS (person agtype, place agtype, other agtype);
