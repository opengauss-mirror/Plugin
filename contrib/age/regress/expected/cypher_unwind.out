LOAD 'age';
SET search_path TO ag_catalog;
SELECT create_graph('cypher_unwind');
NOTICE:  graph "cypher_unwind" has been created
CONTEXT:  referenced column: create_graph
 create_graph 
--------------
 
(1 row)

SELECT * FROM cypher('cypher_unwind', $$
    CREATE (node1 {name: 'node1', a: [1, 2, 3]}),
           (node2 {name: 'node2', a: [4, 5, 6]}),
           (node3 {name: 'node3', a: [7, 8, 9]}),
           (node1)-[:KNOWS]->(node2),
           (node2)-[:KNOWS]->(node3)
$$) as (i agtype);
 i 
---
(0 rows)

SELECT * FROM cypher('cypher_unwind', $$
    UNWIND [1, 2, 3] AS i RETURN i
$$) as (i agtype);
 i 
---
 1
 2
 3
(3 rows)

SELECT * FROM cypher('cypher_unwind', $$
    MATCH (n)
    WITH n.a AS a
    UNWIND a AS i
    RETURN *
    ORDER BY a, i
$$) as (i agtype, j agtype);
     i     | j 
-----------+---
 [1, 2, 3] | 1
 [1, 2, 3] | 2
 [1, 2, 3] | 3
 [4, 5, 6] | 4
 [4, 5, 6] | 5
 [4, 5, 6] | 6
 [7, 8, 9] | 7
 [7, 8, 9] | 8
 [7, 8, 9] | 9
(9 rows)

SELECT * FROM cypher('cypher_unwind', $$
    WITH [[1, 2], [3, 4], 5] AS nested
    UNWIND nested AS x
    UNWIND x AS y
    RETURN y
$$) as (i agtype);
 i 
---
 1
 2
 3
 4
 5
(5 rows)

-- UNWIND vertices
SELECT * FROM cypher('cypher_unwind', $$
    MATCH p=()-[:KNOWS]->()
    UNWIND nodes(p) AS node
    RETURN node.name
    ORDER BY node.name
$$) as (name agtype);
  name   
---------
 "node1"
 "node2"
 "node2"
 "node3"
(4 rows)

-- UNWIND edges
SELECT * FROM cypher('cypher_unwind', $$
    MATCH p=()-[:KNOWS]->()
    UNWIND relationships(p) AS relation
    RETURN type(relation)
    ORDER BY type(relation)
$$) as (relation_type agtype);
 relation_type 
---------------
 "KNOWS"
 "KNOWS"
(2 rows)

-- UNWIND paths
SELECT * FROM cypher('cypher_unwind', $$
    MATCH p=({name: 'node1'})-[:KNOWS*1..2]->({name: 'node3'})
    UNWIND [p] AS path
    RETURN size(relationships(path))
$$) as (edge_count agtype);
 edge_count 
------------
 2
(1 row)

-- #1304: SQL NULL input propagates through UNWIND without detoast errors.
SELECT * FROM cypher('cypher_unwind', $$
    UNWIND NULL AS i
    RETURN i
$$) AS (i agtype);
 i 
---
 
(1 row)

-- any SubLink-producing expression may be unwound, not only a list
-- comprehension
SELECT * FROM cypher('cypher_unwind', $$
    UNWIND reduce(acc = [], x IN [1, 2] | acc + [x]) AS y
    RETURN y
$$) AS (y agtype);
 y 
---
 1
 2
(2 rows)

SELECT * FROM cypher('cypher_unwind', $$
    UNWIND [x IN [1, 2, 3] WHERE x > 1] AS y
    RETURN y
$$) AS (y agtype);
 y 
---
 2
 3
(2 rows)

