-- An unauthorized caller must not be able to distinguish existing from
-- missing server files: authorization fails before any path resolution.
-- The disposable regression postmaster enables enable_copy_server_files in
-- age_regress.conf, so the observable failure is the role gate; both files
-- must raise the same path-independent error.
CREATE ROLE agload_secrecy_role PASSWORD 'Gauss_123';
