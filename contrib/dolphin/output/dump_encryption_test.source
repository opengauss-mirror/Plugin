set dolphin.b_compatibility_mode to off;
DROP DATABASE IF EXISTS dump_enc_src;
NOTICE:  database "dump_enc_src" does not exist, skipping
CREATE DATABASE dump_enc_src DBCOMPATIBILITY 'B';
\c dump_enc_src
CREATE TABLE bulk_data (id int, name varchar(64), ts timestamp);
INSERT INTO bulk_data
    SELECT g, 'row-' || g, now() - (g || ' seconds')::interval
    FROM generate_series(1, 200) g;
delimiter //
CREATE PROCEDURE p_begin_body()
BEGIN
    INSERT INTO bulk_data VALUES (20000, 'from-begin', now());
END;
//
CREATE PROCEDURE p_declare_body()
AS DECLARE BEGIN
    FOR i IN 1..3 LOOP
        INSERT INTO bulk_data VALUES (10000 + i, 'from-declare-' || i, now());
    END LOOP;
END;
//
delimiter ;
SELECT count(*) AS bulk_data_src FROM bulk_data;
 bulk_data_src 
---------------
           200
(1 row)

--?.*
--?.*
--?.*
--?.*
--?.*
--?.*
--?.*
DROP DATABASE IF EXISTS dump_enc_tgt;
NOTICE:  DROP DATABASE will change to DROP SCHEMA when dolphin.b_compatibility_mode is on.
NOTICE:  schema "dump_enc_tgt" does not exist, skipping
CREATE DATABASE dump_enc_tgt DBCOMPATIBILITY 'B';
--?.*
\c dump_enc_tgt
SELECT count(*) AS bulk_data_tgt FROM bulk_data;
 bulk_data_tgt 
---------------
           200
(1 row)

SELECT count(*) AS procs_tgt FROM pg_proc
  WHERE proname IN ('p_begin_body', 'p_declare_body');
 procs_tgt 
-----------
         2
(1 row)

CALL p_begin_body();
CALL p_declare_body();
SELECT count(*) AS bulk_data_after_calls FROM bulk_data;
 bulk_data_after_calls 
-----------------------
                   204
(1 row)

-- Cleanup
\c postgres
DROP DATABASE IF EXISTS dump_enc_src;
DROP DATABASE IF EXISTS dump_enc_tgt;
--?.*
